---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<MainLayout title="Projects | My Portfolio">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-2">My Projects</h1>
    <p class="text-muted-foreground mb-8">A collection of my work and side projects</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <p class="text-muted-foreground">
        Want to see more? Check out my 
        <a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
          GitHub profile
        </a> 
        for additional projects and contributions.
      </p>
    </div>
  </div>
</MainLayout>
