---
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { projects } from '../data/projects'

// The Contentful imports and interface are kept for future reference
import { documentToHtmlString } from '@contentful/rich-text-html-renderer'
import type { EntryFieldTypes } from 'contentful'

interface ContentfulProject {
  contentTypeId: 'Projects'
  fields: {
    name: EntryFieldTypes.Text
    img: EntryFieldTypes.AssetLink
    website: EntryFieldTypes.EntryResourceLink<any>
    repositorio: EntryFieldTypes.EntryResourceLink<any>
  }
}

// const entries = await contentfulClient.getEntries<Project>({})
---

<BaseLayout
  title="Portfolio"
  description="Projects and some clone's that I did"
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="slide">
    <TopLayout>
      <h2
        class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Projects and Work
      </h2>
      <p class="mt-2 text-muted-foreground">A showcase of my recent projects and development work</p>
    </TopLayout>
    <BottomLayout>
      <div class="flex w-full flex-wrap justify-center gap-6">
        {
          projects.map((project) => (
            <div class="w-full sm:w-[47%] lg:w-[31%] xl:w-[30%] mb-8 overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300">
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
      
      <div class="text-center mt-12 text-sm text-muted-foreground">
        <p>Website screenshots are automatically generated using the ScreenshotOne API</p>
      </div>
    </BottomLayout>
  </main>
</BaseLayout>
