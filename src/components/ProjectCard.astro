---
import { Github, ExternalLink } from 'lucide-react';
import { Button } from './ui/button';
import type { Project } from '../data/projects';
import { getScreenshotUrl } from '../data/projects';
import { config } from '../lib/config';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Determine image source - use screenshot if specified and live URL exists
const imageSource = project.useScreenshot && project.liveUrl 
  ? getScreenshotUrl(project.liveUrl, config.screenshotOneApiKey)
  : project.imageUrl;
---

<div class="card bg-base-100 shadow-xl transition-all hover:shadow-2xl">
  {imageSource && (
    <figure>
      <img 
        src={imageSource} 
        alt={`Screenshot of ${project.title}`} 
        class="w-full h-48 object-cover"
        loading="lazy" 
      />
    </figure>
  )}
  <div class="card-body">
    <h2 class="card-title">{project.title}</h2>
    <p class="text-sm text-muted-foreground">{project.description}</p>
    
    <div class="flex flex-wrap gap-1 mt-2">
      {project.tags.map((tag) => (
        <span class="badge badge-outline">{tag}</span>
      ))}
    </div>
    
    <div class="card-actions justify-end mt-4">
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="sm">
            <Github class="h-4 w-4 mr-2" />
            Code
          </Button>
        </a>
      )}
      
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">
          <Button size="sm">
            <ExternalLink class="h-4 w-4 mr-2" />
            Live Demo
          </Button>
        </a>
      )}
    </div>
  </div>
</div>
