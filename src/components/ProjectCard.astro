---
import { Github, ExternalLink } from 'lucide-react';
import { Button } from './ui/button';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Simplify the image source logic
const imageSource = project.imageUrl;
---

<div class="card bg-base-100 border border-muted/20 shadow-md hover:shadow-lg transition-all duration-300 overflow-hidden h-full flex flex-col">
  {imageSource && (
    <figure class="relative group overflow-hidden">
      <img 
        src={imageSource} 
        alt={`Screenshot of ${project.title}`} 
        class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-105" 
        loading="lazy" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
        <p class="text-white text-sm line-clamp-3">{project.description}</p>
      </div>
    </figure>
  )}
  
  <div class="card-body p-4 flex-grow flex flex-col">
    <div class="flex-grow">
      <h2 class="card-title text-lg font-semibold line-clamp-1">{project.title}</h2>
      <div class="flex flex-wrap gap-1 mt-2">
        {project.tags.map((tag) => (
          <span class="badge badge-sm badge-outline text-xs py-0.5">{tag}</span>
        ))}
      </div>
      
      <p class="text-sm text-muted-foreground mt-3 line-clamp-2 md:line-clamp-3">{project.description}</p>
    </div>
    
    <div class="card-actions justify-end mt-4 pt-2 border-t border-muted/10">
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
          <Button variant="outline" size="sm">
            <Github class="h-4 w-4 mr-2" />
            Code
          </Button>
        </a>
      )}
      
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">
          <Button size="sm">
            <ExternalLink class="h-4 w-4 mr-2" />
            Live Demo
          </Button>
        </a>
      )}
    </div>
  </div>
</div>
